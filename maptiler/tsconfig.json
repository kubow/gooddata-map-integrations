{
    "exclude": ["**/tests", "**/test"],
    "include": ["src/**/*", "src/**/*.json"],
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./esm",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "ESNext",
        // @maptiler/sdk ships a `.d.ts` with an extension-less relative re-export, which strict
        // Node16/NodeNext resolution rejects (and hides all of its named exports as a result).
        // "bundler" mode matches how Vite actually resolves these modules at build time.
        "moduleResolution": "bundler",
        "jsx": "react",
        "importHelpers": true,
        "incremental": false,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    }
}
