{
    "exclude": ["**/tests", "**/test"],
    "include": ["src/**/*", "src/**/*.json"],
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./esm",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "ESNext",
        // `ol` ships extension-less subpath imports (e.g. "ol/Map") with no package.json
        // "exports" map, which strict Node16/NodeNext resolution rejects. "bundler" mode matches
        // how Vite actually resolves these modules at build time.
        "moduleResolution": "bundler",
        "jsx": "react",
        "importHelpers": true,
        "incremental": false,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    }
}
